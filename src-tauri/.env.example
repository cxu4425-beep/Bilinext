# Port the API + web server listens on
PORT=8787
# Bind address. 0.0.0.0 lets your phone reach it over the LAN.
HOST=0.0.0.0
# Optional: supply the 32-byte store key as 64 hex chars instead of keeping it
# in data/key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BILI_STORE_KEY=
LOG_LEVEL=info
