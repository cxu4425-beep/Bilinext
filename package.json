{
  "name": "bili-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/src/index.js",
    "dev:web": "npm -w web run dev",
    "build": "npm -w web run build",
    "start": "node server/src/index.js",
    "build:native": "npm -w web run build -- --mode capacitor",
    "android:sync": "npm run build:native && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "npm run android:sync && node scripts/android-apk.mjs assembleDebug",
    "android:aab": "npm run android:sync && node scripts/android-apk.mjs bundleRelease",
    "desktop:dev": "npm -w web run build && tauri dev",
    "desktop:build": "npm -w web run build && tauri build",
    "test": "node --experimental-strip-types web/src/lib/danmakuLanes.test.ts"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6"
  }
}
